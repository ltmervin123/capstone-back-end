// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  HR
  EMPLOYEE
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  role          Role           @default(EMPLOYEE)
  isActive      Boolean        @default(true)
  isApproved    Boolean        @default(false)
  permissions   Json?
  employeeId    String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  employee                         Employee?                  @relation(fields: [employeeId], references: [employeeNumber], onDelete: SetNull)
  refreshTokens                    RefreshToken[]
  employeesCreated                 Employee[]                 @relation("EmployeeCreatedBy")
  employeesUpdated                 Employee[]                 @relation("EmployeeUpdatedBy")
  employmentChangesCreated         EmploymentStatusChange[]   @relation("EmploymentChangeCreatedBy")
  employmentChangesApproved        EmploymentStatusChange[]   @relation("EmploymentChangeApprovedBy")
  performanceEvaluationsAsEvaluator PerformanceEvaluation[]   @relation("PerformanceEvaluator")
  performanceEvaluationsUpdated    PerformanceEvaluation[]    @relation("PerformanceUpdatedBy")
  checklistCompletions             EmployeeDocumentChecklist[] @relation("ChecklistCompletedBy")
  documentsUploaded                EmployeeDocument[]         @relation("DocumentUploadedBy")
  attendanceRecorded               AttendanceRecord[]         @relation("AttendanceRecordedBy")
  leavesCreated                    LeaveRecord[]              @relation("LeaveCreatedBy")
  leavesApproved                   LeaveRecord[]              @relation("LeaveApprovedBy")
  payrollProcessed                 PayrollRecord[]            @relation("PayrollProcessedBy")
  applicantsUpdated                Applicant[]                @relation("ApplicantUpdatedBy")
  feedbackSent                     FeedbackItem[]             @relation("FeedbackSender")
  feedbackResponded                FeedbackItem[]             @relation("FeedbackResponder")
  auditLogs                        AuditLog[]
  aiQueryLogs                      AiQueryLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Lookups
// ---------------------------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees                   Employee[]
  applicants                  Applicant[]
  employmentChangesPrevious   EmploymentStatusChange[] @relation("PreviousDepartment")
  employmentChangesNew        EmploymentStatusChange[] @relation("NewDepartment")

  @@map("departments")
}

// ---------------------------------------------------------------------------
// Core HR
// ---------------------------------------------------------------------------

enum Sex {
  MALE
  FEMALE
  OTHER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RETIRED
}

model Employee {
  id                 String         @id @default(cuid())
  employeeNumber     String         @unique
  surname            String
  firstName          String
  middleName         String?
  dateOfBirth        DateTime       @db.Date
  sex                Sex
  maritalStatus      String
  religion           String?
  homeAddress        String         @db.Text
  contactNumber      String
  email              String         @unique
  profilePictureUrl  String?

  departmentId       String
  position           String
  employmentDate     DateTime       @db.Date
  serviceDuration    String?
  status             EmployeeStatus @default(ACTIVE)

  educationLevel     String?
  bachelorsDegree    String?
  mastersStatus      String?
  mastersDegreeName  String?
  doctorateStatus    String?

  functionalRate     Decimal?       @db.Decimal(12, 2)
  gasolineAllowance  Decimal?       @db.Decimal(12, 2)
  cashAdvanceBalance Decimal?       @db.Decimal(12, 2)
  employeeShare      Decimal?       @db.Decimal(12, 2)

  createdById        String?
  updatedById        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  department              Department                  @relation(fields: [departmentId], references: [id])
  createdBy               User?                       @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy               User?                       @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  user                      User?
  employmentStatusChanges   EmploymentStatusChange[]
  performanceEvaluations    PerformanceEvaluation[]
  documentChecklist         EmployeeDocumentChecklist[]
  documents                 EmployeeDocument[]
  attendanceRecords         AttendanceRecord[]
  leaveRecords              LeaveRecord[]
  payrollRecords            PayrollRecord[]
  feedbackItems             FeedbackItem[]

  @@index([departmentId])
  @@index([status])
  @@index([dateOfBirth])
  @@index([employmentDate])
  @@map("employees")
}

enum EmploymentChangeType {
  PROMOTION
  TRANSFER
  RETIREMENT
  REINSTATEMENT
  POSITION_CHANGE
}

model EmploymentStatusChange {
  id                   String               @id @default(cuid())
  employeeId           String
  changeType           EmploymentChangeType
  effectiveDate        DateTime             @db.Date
  previousPosition     String?
  newPosition          String?
  previousDepartmentId String?
  newDepartmentId      String?
  previousStatus       EmployeeStatus?
  newStatus            EmployeeStatus?
  remarks              String?              @db.Text
  approvedById         String?
  createdById          String?
  createdAt            DateTime             @default(now())

  employee           Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousDepartment Department? @relation("PreviousDepartment", fields: [previousDepartmentId], references: [id], onDelete: SetNull)
  newDepartment      Department? @relation("NewDepartment", fields: [newDepartmentId], references: [id], onDelete: SetNull)
  approvedBy         User?       @relation("EmploymentChangeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy          User?       @relation("EmploymentChangeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([changeType])
  @@index([effectiveDate])
  @@map("employment_status_changes")
}

model PerformanceEvaluation {
  id               String    @id @default(cuid())
  employeeId       String
  evaluationPeriod String
  evaluationDate   DateTime  @db.Date
  rating           Decimal?  @db.Decimal(5, 2)
  ratingLabel      String?
  summary          String?   @db.Text
  evaluatorName    String?
  evaluatorId      String?
  documentUrl      String?
  updatedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  evaluator  User?    @relation("PerformanceEvaluator", fields: [evaluatorId], references: [id], onDelete: SetNull)
  updatedBy  User?    @relation("PerformanceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([evaluationDate])
  @@map("performance_evaluations")
}

// ---------------------------------------------------------------------------
// Record digitization
// ---------------------------------------------------------------------------

model DocumentCategory {
  id        String         @id
  title     String
  sortOrder Int
  types     DocumentType[]

  @@map("document_categories")
}

model DocumentType {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  isRequired Boolean  @default(true)
  sortOrder  Int

  category          DocumentCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  checklistItems    EmployeeDocumentChecklist[]
  documents         EmployeeDocument[]

  @@unique([categoryId, name])
  @@index([categoryId])
  @@map("document_types")
}

model EmployeeDocumentChecklist {
  id             String    @id @default(cuid())
  employeeId     String
  documentTypeId String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  completedById  String?
  notes          String?   @db.Text

  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType  DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  completedBy   User?        @relation("ChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, documentTypeId])
  @@index([employeeId])
  @@map("employee_document_checklist")
}

model EmployeeDocument {
  id             String    @id @default(cuid())
  employeeId     String
  documentTypeId String?
  fileName       String
  filePath       String
  mimeType       String
  fileSizeBytes  Int
  uploadedAt     DateTime  @default(now())
  uploadedById   String?
  extractedText  String?   @db.Text
  isIndexed      Boolean   @default(false)
  indexedAt      DateTime?

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: SetNull)
  uploadedBy   User?         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([documentTypeId])
  @@index([isIndexed])
  @@map("employee_documents")
}

// ---------------------------------------------------------------------------
// HR operations
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  employeeId   String
  date         DateTime         @db.Date
  timeIn       String?
  timeOut      String?
  status       AttendanceStatus
  remarks      String?          @db.Text
  recordedById String?
  createdAt    DateTime         @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User?    @relation("AttendanceRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@map("attendance_records")
}

enum LeaveType {
  SICK
  VACATION
  EMERGENCY
  MATERNITY_PATERNITY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRecord {
  id           String      @id @default(cuid())
  employeeId   String
  leaveType    LeaveType
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String      @db.Text
  status       LeaveStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  createdById  String?
  createdAt    DateTime    @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  approvedBy User?    @relation("LeaveApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  User?    @relation("LeaveCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_records")
}

model PayrollRecord {
  id              String   @id @default(cuid())
  employeeId      String
  month           String
  year            Int
  functionalRate  Decimal  @db.Decimal(12, 2)
  daysWorked      Int
  basicSalary     Decimal  @db.Decimal(12, 2)
  allowances      Decimal  @db.Decimal(12, 2)
  gasoline        Decimal  @db.Decimal(12, 2) @default(0)
  cashAdvance     Decimal  @db.Decimal(12, 2) @default(0)
  employeeShare   Decimal  @db.Decimal(12, 2) @default(0)
  otherDeductions Decimal @db.Decimal(12, 2) @default(0)
  totalDeductions Decimal  @db.Decimal(12, 2)
  netPay          Decimal  @db.Decimal(12, 2)
  processedById   String?
  createdAt       DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  processedBy User?    @relation("PayrollProcessedBy", fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, month, year])
  @@index([employeeId])
  @@index([year])
  @@map("payroll_records")
}

// ---------------------------------------------------------------------------
// Supporting modules
// ---------------------------------------------------------------------------

enum ApplicantStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
}

model Applicant {
  id              String          @id @default(cuid())
  fullName        String
  email           String
  phone           String
  positionApplied String
  departmentId    String?
  status          ApplicantStatus @default(APPLIED)
  appliedDate     DateTime        @db.Date
  resumeUrl       String?
  notes           String?         @db.Text
  updatedById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  updatedBy  User?       @relation("ApplicantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([appliedDate])
  @@map("applicants")
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  RESOLVED
}

model FeedbackItem {
  id               String         @id @default(cuid())
  senderUserId     String?
  senderEmployeeId String?
  senderName       String
  senderEmail      String
  category         String
  subject          String
  message          String         @db.Text
  isAnonymous      Boolean        @default(false)
  status           FeedbackStatus @default(NEW)
  adminResponse    String?        @db.Text
  respondedById    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  senderUser     User?     @relation("FeedbackSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  senderEmployee Employee? @relation(fields: [senderEmployeeId], references: [id], onDelete: SetNull)
  respondedBy    User?     @relation("FeedbackResponder", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("feedback_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  username   String
  action     String
  entityType String?
  entityId   String?
  details    String?  @db.Text
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AiQueryLog {
  id           String   @id @default(cuid())
  userId       String
  queryText    String   @db.Text
  responseText String?  @db.Text
  sourcesUsed  Json?
  latencyMs    Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_query_logs")
}
